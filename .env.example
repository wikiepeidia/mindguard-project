# MindGuard v2 — Environment Variables
# Copy this file and fill in real values for your deployment.
# On Vercel: set these in Project Settings > Environment Variables.
# For local dev: you can also use .env/*.json files (see config.py load_local_env).

# ── Flask Core ──────────────────────────────────────────
SECRET_KEY=your-flask-secret-key-here

# ── Database (NeonDB PostgreSQL) ────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── AI Chatbot (OpenRouter) ─────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# ── Cloudflare Turnstile (CAPTCHA) ──────────────────────
CLOUDFLARE_SITE_KEY=your-cloudflare-site-key-here
CLOUDFLARE_SECRET_KEY=your-cloudflare-secret-key-here

# ── Admin ───────────────────────────────────────────────
ADMIN_PASSWORD=your-admin-password-here
REPORT_ENCRYPTION_KEY=your-encryption-key-here
ADMIN_UNSUSPEND_SECRET=your-unsuspend-secret-here

# ── Anti-Spam Configuration (optional — defaults shown) ─
ABUS_MODE=monitor
ABUS_WINDOW_MINUTES=10
ABUS_THRESHOLD_COUNT=3
ABUS_COOLDOWN_MINUTES=15
ABUS_ACCOUNT_WEIGHT=70
ABUS_COOKIE_WEIGHT=20
ABUS_IP_WEIGHT=10
